[Unit]
Description=Agent Interchange Experiment application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentinterchange
Group=agentinterchange
WorkingDirectory=/opt/agent-interchange
EnvironmentFile=/etc/agent-interchange.env
ExecStart=/opt/agent-interchange/venv/bin/gunicorn --config /opt/agent-interchange/gunicorn.conf.py app.wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/agent-interchange
UMask=027

[Install]
WantedBy=multi-user.target

